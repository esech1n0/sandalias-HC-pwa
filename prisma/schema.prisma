// ==============================================================================
// Prisma Schema - Sandalias y Pantuflas HC (HC Venta)
// ==============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum InventoryMovementType {
  SALE
  PURCHASE
  ADJUSTMENT
}

enum CashMovementType {
  OPENING
  SALE
  WITHDRAWAL
  EXPENSE
  PURCHASE
  ADJUSTMENT
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARY
  TRANSPORT
  MAINTENANCE
  OTHER
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum NotificationType {
  LOW_STOCK
  SYSTEM_UPDATE
  WEEKLY_REPORT
  MONTHLY_REPORT
}

// ------------------------------------------------------------------------------
// Usuarios y Autenticación
// ------------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  sessions            Session[]
  sales               Sale[]
  openedRegisters     CashRegister[]      @relation("OpenedRegisters")
  closedRegisters     CashRegister[]      @relation("ClosedRegisters")
  cashMovements       CashMovement[]
  inventoryMovements  InventoryMovement[]
  expenses            Expense[]
  purchases           Purchase[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

// ------------------------------------------------------------------------------
// Catálogo: Categorías y Productos
// ------------------------------------------------------------------------------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#cfd500")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  salePrice   Decimal  @db.Decimal(12, 2)
  currentCost Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  minStock    Int      @default(5)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  costHistories       ProductCostHistory[]
  inventoryMovements  InventoryMovement[]
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  notifications       Notification[]

  @@map("products")
}

model ProductCostHistory {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cost              Decimal  @db.Decimal(12, 2)
  quantityPurchased Int
  reason            String?
  createdAt         DateTime @default(now())

  @@map("product_cost_history")
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          InventoryMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id])
  createdAt     DateTime              @default(now())

  @@map("inventory_movements")
}

// ------------------------------------------------------------------------------
// Compras / Entradas de Mercancía
// ------------------------------------------------------------------------------

model Purchase {
  id             String         @id @default(cuid())
  folio          String         @unique
  supplier       String?
  total          Decimal        @db.Decimal(12, 2)
  paymentMethod  PaymentMethod  @default(CASH)
  notes          String?
  cashRegisterId String?
  cashRegister   CashRegister?  @relation(fields: [cashRegisterId], references: [id])
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  createdAt      DateTime       @default(now())

  items          PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@map("purchase_items")
}

// ------------------------------------------------------------------------------
// Ventas, Partidas y Pagos (Inmutables)
// ------------------------------------------------------------------------------

model Sale {
  id             String         @id @default(cuid())
  folio          String         @unique
  subtotal       Decimal        @db.Decimal(12, 2)
  discountType   DiscountType?
  discountValue  Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  totalCost      Decimal        @db.Decimal(12, 2)
  grossProfit    Decimal        @db.Decimal(12, 2)

  cashRegisterId String?
  cashRegister   CashRegister?  @relation(fields: [cashRegisterId], references: [id])
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  createdAt      DateTime       @default(now())

  items          SaleItem[]
  payments       Payment[]

  @@map("sales")
}

model SaleItem {
  id             String        @id @default(cuid())
  saleId         String
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  productName    String
  quantity       Int
  originalPrice  Decimal       @db.Decimal(12, 2)
  unitPrice      Decimal       @db.Decimal(12, 2)
  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  unitCost       Decimal       @db.Decimal(12, 2)
  subtotal       Decimal       @db.Decimal(12, 2)
  totalCost      Decimal       @db.Decimal(12, 2)
  profit         Decimal       @db.Decimal(12, 2)

  @@map("sale_items")
}

model Payment {
  id             String        @id @default(cuid())
  saleId         String
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  receivedAmount Decimal?      @db.Decimal(12, 2)
  changeGiven    Decimal?      @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  @@map("payments")
}

// ------------------------------------------------------------------------------
// Caja y Movimientos de Efectivo
// ------------------------------------------------------------------------------

model CashRegister {
  id                String             @id @default(cuid())
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  openingBalance    Decimal            @db.Decimal(12, 2)
  cashSales         Decimal            @default(0) @db.Decimal(12, 2)
  cardSales         Decimal            @default(0) @db.Decimal(12, 2)
  transferSales     Decimal            @default(0) @db.Decimal(12, 2)
  withdrawalsTotal  Decimal            @default(0) @db.Decimal(12, 2)
  expensesCashTotal Decimal            @default(0) @db.Decimal(12, 2)
  expectedCash      Decimal            @default(0) @db.Decimal(12, 2)
  countedCash       Decimal?           @db.Decimal(12, 2)
  difference        Decimal?           @db.Decimal(12, 2)
  status            CashRegisterStatus @default(OPEN)

  openedById        String
  openedBy          User               @relation("OpenedRegisters", fields: [openedById], references: [id])
  closedById        String?
  closedBy          User?              @relation("ClosedRegisters", fields: [closedById], references: [id])
  notes             String?

  sales             Sale[]
  movements         CashMovement[]
  expenses          Expense[]
  purchases         Purchase[]

  @@map("cash_registers")
}

model CashMovement {
  id             String           @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  reason         String
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())

  @@map("cash_movements")
}

// ------------------------------------------------------------------------------
// Gastos del Negocio (Independientes de Retiros)
// ------------------------------------------------------------------------------

model Expense {
  id             String          @id @default(cuid())
  concept        String
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  date           DateTime        @default(now())
  paymentMethod  PaymentMethod   @default(CASH)
  description    String?
  cashRegisterId String?
  cashRegister   CashRegister?   @relation(fields: [cashRegisterId], references: [id])
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  createdAt      DateTime        @default(now())

  @@map("expenses")
}

// ------------------------------------------------------------------------------
// Notificaciones
// ------------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  productId String?
  product   Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

// ------------------------------------------------------------------------------
// Configuración del Sistema
// ------------------------------------------------------------------------------

model SystemSettings {
  id                  String   @id @default("default")
  allowBelowCostSales Boolean  @default(true)
  defaultMinStock     Int      @default(5)
  businessName        String   @default("Sandalias HC")
  headerColor         String   @default("#cfd500")
  updatedAt           DateTime @updatedAt

  @@map("system_settings")
}
