# ==============================================================================
# HC Venta - Variables de Entorno (Plantilla)
# ==============================================================================
# IMPORTANTE:
# - NO colocar credenciales reales en este archivo.
# - Copia este archivo a `.env.local` o `.env` y configura tus valores reales.
# - Las credenciales de `develop` y `production` deben mantenerse estrictamente separadas.

# ------------------------------------------------------------------------------
# Base de Datos (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Conexión pooled (para la aplicación en runtime y consultas rápidas)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[EP_HOST]-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Conexión directa (para migraciones CLI de Prisma y operaciones DDL)
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[EP_HOST].region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# Seguridad y Autenticación
# ------------------------------------------------------------------------------
# SESSION_SECRET: Cadena secreta de al menos 32 caracteres utilizada para firmar sesiones JWT
SESSION_SECRET="genera_una_clave_secreta_de_32_o_mas_caracteres_aqui"

# ------------------------------------------------------------------------------
# Configuración General de la Aplicación
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="HC Venta - Sandalias HC"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
